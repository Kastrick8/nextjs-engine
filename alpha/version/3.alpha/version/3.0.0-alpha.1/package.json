{
	"name": "@kastrick/nextjs-engine",
	"version": "3.0.0-alpha.1",
	"description": "Next.js Engine Generation 3 prerelease package with compiler-first, server-first, and adaptive runtime architecture.",
	"private": false,
	"sideEffects": false,
	"files": [
		"engine",
		"docs",
		"DOCUMENT.md",
		"README.md",
		"index.ts"
	],
	"exports": {
		".": {
			"types": "./index.ts",
			"import": "./index.ts",
			"default": "./index.ts"
		},
		"./server": {
			"types": "./engine/server.ts",
			"import": "./engine/server.ts",
			"default": "./engine/server.ts"
		},
		"./plugin": {
			"require": "./engine/plugins/enginePlugin.js",
			"default": "./engine/plugins/enginePlugin.js"
		},
		"./api-plugin": {
			"require": "./engine/plugins/engineApiPlugin.js",
			"default": "./engine/plugins/engineApiPlugin.js"
		},
		"./shader-plugin": {
			"require": "./engine/plugins/engineShaderPlugin.js",
			"default": "./engine/plugins/engineShaderPlugin.js"
		},
		"./network": {
			"types": "./engine/network.ts",
			"import": "./engine/network.ts",
			"default": "./engine/network.ts"
		},
		"./nenc-plugin": {
			"require": "./engine/plugins/nencPlugin.js",
			"default": "./engine/plugins/nencPlugin.js"
		},
		"./seo": {
			"types": "./engine/seo.ts",
			"import": "./engine/seo.ts",
			"default": "./engine/seo.ts"
		},
		"./seo-plugin": {
			"require": "./engine/plugins/engineSEOPlugin.js",
			"default": "./engine/plugins/engineSEOPlugin.js"
		}
	},
	"types": "./index.ts",
	"scripts": {
		"type-check": "tsc --noEmit",
		"pack:check": "npm pack --dry-run"
	},
	"peerDependencies": {
		"next": "^16.3.3",
		"next-view-transitions": "^0.3.5",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"three": "^0.184.0"
	},
	"devDependencies": {
		"@types/node": "^20.10.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/three": "^0.185.0",
		"next-view-transitions": "^0.3.5"
	},
	"keywords": [
		"nextjs",
		"react",
		"schema",
		"ui-engine",
		"canvas",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Kate-alt-69/nextjs-engine.git"
	},
	"homepage": "https://github.com/Kate-alt-69/nextjs-engine#readme",
	"dependencies": {
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"two.js": "^0.8.23",
		"typescript": "^5.9.3"
	}
}
