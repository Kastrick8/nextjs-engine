{
  "schemaVersion": 1,
  "description": "Machine-readable index for the authoritative Generation 3 Nextjs Engine Error Code Book. Subsystem pages contain the meaning, likely cause and recommended action.",
  "publicBaseUrl": "https://kastrick.vercel.app/project/nextjs-engine/doc/error-codes",
  "codeFormat": "PREFIX1234",
  "numericRanges": {
    "1xxx": "input/source/parse/validation",
    "2xxx": "semantic/configuration/policy/authorization",
    "3xxx": "compile/lowering/artifact preparation",
    "4xxx": "runtime/lifecycle",
    "5xxx": "workers/process/package/build/bootstrap",
    "8xxx": "external dependencies/platform",
    "9xxx": "internal invariants"
  },
  "prefixes": {
    "NECORE": "Structured reports, route/global boundaries, request instrumentation and Node fatal exceptions",
    "NENC": "Gen 3 source discovery, static analysis, compilation, client islands, artifacts and worker output",
    "NECFG": "Config parsing, generated error files, plugin lifecycle and file ownership",
    "NEBLD": "Build integration, deterministic artifacts, cache validation, budgets, measurements and output writes",
    "NECMP": "Schema validation, custom component registration, props, accessibility and node identity",
    "NETH": "Theme IDs/scopes, tokens, .etr artifacts, fonts and remote loading",
    "NEMD": "Markdown parsing, GFM, server rendering, highlighting and link decoration",
    "NEIMG": "Image source, sizing/optimization, fallback loading and remote host rules",
    "NEAPI": "Provider config, route declarations, request validation and handler execution",
    "NESCHED": "Scheduling policies, target lifecycle, observers, callbacks, EngineScroll point metadata and frame budgets",
    "NEDEBUG": "Dev route discovery, preview navigation, source mapping and production isolation",
    "NESEO": "Metadata normalization, canonical URLs, JSON-LD and sitemaps",
    "NENET": "Command transport, session/CSRF checks, replay controls, backend requests and Web Crypto",
    "NEMIG": "Legacy configuration, renderer compatibility and source migration",
    "NEVIS": "Visual rendering, shaders, animation, scroll state and transition lifecycle",
    "NESEC": "Origin checks, identity/device proof, unsafe values and secret-safe reporting"
  },
